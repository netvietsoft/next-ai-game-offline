# ==============================================================================
# BACKEND & CMS CONFIGURATION (NextAI Game Offline Platform)
# ==============================================================================

# Server Port
PORT=6033
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite://./data/nextai_games.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextai_games

# JWT Authentication for Admin CMS
JWT_SECRET=nextai_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRATION=7d

# Admin Default Credentials
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=NextAIAdmin@2026
ADMIN_DEFAULT_EMAIL=admin@nextai.com

# Cloudflare R2 / AWS S3 Media Storage Configuration
CLOUDFLARE_R2_ACCOUNT_ID=demo_account_id_change_later
CLOUDFLARE_R2_ACCESS_KEY_ID=demo_access_key_change_later
CLOUDFLARE_R2_SECRET_ACCESS_KEY=demo_secret_key_change_later
CLOUDFLARE_R2_BUCKET_NAME=nextai-game-assets
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://assets.nextai.com

# Google Play Developer API (Receipt Validation)
GOOGLE_PLAY_PACKAGE_NAME=com.nextai.gameoffline
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=./config/google-service-account.json

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=nextai-games-offline
FIREBASE_PRIVATE_KEY="demo_firebase_private_key"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@nextai-games-offline.iam.gserviceaccount.com
