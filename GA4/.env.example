# ==============================================================================
# CẤU HÌNH KẾT NỐI GOOGLE ANALYTICS 4 (GA4) - GAME GATE OFFLINE
# GOOGLE ANALYTICS 4 (GA4) CONNECTION CONFIGURATION
# ==============================================================================
# Sao chép file này thành GA4/.env và điền thông số thực tế (KHÔNG commit .env lên Git).
# Copy this file to GA4/.env and fill in real values (DO NOT commit .env to Git).

# Mã Property ID của GA4 (dãy 9 chữ số trong GA4 Admin -> Property details).
# Để trống nếu muốn hệ thống tự động dò tìm theo project "nextai-game-offline".
# GA4 Property ID (numeric ID in GA4 Admin -> Property details).
# Leave blank to auto-discover by project/app name.
GA4_PROPERTY_ID=

# Đường dẫn tới file JSON Service Account tải từ Google Cloud Console.
# Path to Service Account JSON key downloaded from Google Cloud Console.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Số ngày mặc định cần kéo dữ liệu khi không truyền --days hoặc --start-date.
# Default lookback days when --days or --start-date is omitted.
GA4_DEFAULT_DAYS=30

# Múi giờ tham chiếu hiển thị báo cáo (dữ liệu GA4 dùng múi giờ cấu hình trên Property).
# Reference timezone for report display (GA4 API returns data in the Property timezone).
GA4_TIMEZONE=Asia/Ho_Chi_Minh
