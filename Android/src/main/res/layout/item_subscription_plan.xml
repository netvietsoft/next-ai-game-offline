<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/paywall_card_gap"
    android:background="@drawable/bg_paywall_plan"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:importantForAccessibility="yes"
    android:minHeight="@dimen/paywall_plan_min_height"
    android:orientation="horizontal"
    android:padding="@dimen/paywall_card_padding">

    <View
        android:id="@+id/planRadio"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/bg_paywall_radio"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/planColumns"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/planNameColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/planName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/paywall_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/planTrial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/paywall_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/planPriceColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/planPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:minHeight="24dp"
                android:textColor="@color/paywall_text"
                android:textSize="18sp"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="13sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/planPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="end"
                android:textColor="@color/paywall_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
