<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBillingLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_paywall_screen">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:letterSpacing="0.12"
            android:text="@string/paywall_brand"
            android:textColor="@color/paywall_text_secondary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            app:tint="@color/paywall_text_secondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        app:layout_constraintBottom_toTopOf="@id/purchaseFooter"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:id="@+id/paywallBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/paywall_page_padding"
            android:paddingBottom="12dp">

            <!-- Tiêu đề chính PREMIUM cỡ lớn (đã bỏ icon game và dòng Play without interruptions) -->
            <TextView
                android:id="@+id/tvPaywallHeroPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="@string/paywall_premium_badge"
                android:textAllCaps="true"
                android:textColor="@color/paywall_gold"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/paywall_hero_description"
                android:textColor="@color/paywall_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:text="@string/paywall_benefit_no_ads"
                    android:textColor="@color/paywall_text"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_paywall_check" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:text="@string/paywall_benefit_cancel"
                    android:textColor="@color/paywall_text"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_paywall_check" />
            </LinearLayout>

            <TextView
                android:id="@+id/planSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/paywall_select_heading"
                android:textColor="@color/paywall_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/subscriptionPlans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/billingStatePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_paywall_plan"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ProgressBar
                    android:id="@+id/billingProgress"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginBottom="12dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/paywall_accent" />

                <TextView
                    android:id="@+id/billingStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/paywall_loading_title"
                    android:textColor="@color/paywall_text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvBillingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:text="@string/paywall_loading_body"
                    android:textColor="@color/paywall_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnRetryOwnership"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/paywall_retry_short"
                    android:textColor="@color/paywall_accent"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Thẻ đổi Vé Sạch Quảng Cáo 20 phút bằng 2 Rewarded Video cho người dùng chưa mua VIP -->
            <LinearLayout
                android:id="@+id/cardAdFreePass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_paywall_plan"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_paywall_badge"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/ad_free_pass_badge"
                        android:textColor="@color/paywall_gold"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvPaywallAdFreeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/ad_free_pass_title"
                        android:textColor="@color/paywall_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPaywallAdFreeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/ad_free_pass_subtitle"
                    android:textColor="@color/paywall_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/purchaseFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paywall_footer"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/paywall_page_padding"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/selectedOfferTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/paywall_account_pricing"
            android:textColor="@color/paywall_text_secondary"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinueSubscription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_paywall_action"
            android:enabled="false"
            android:fontFamily="sans-serif-medium"
            android:minHeight="56dp"
            android:paddingVertical="14dp"
            android:text="@string/paywall_cta_loading"
            android:textAllCaps="false"
            android:textColor="@color/paywall_text"
            android:textSize="16sp"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/paywall_secure_checkout"
            android:textColor="@color/paywall_text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPaywallPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/paywall_privacy_short"
                android:textColor="@color/paywall_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPaywallTerms"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/paywall_terms_short"
                android:textColor="@color/paywall_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
