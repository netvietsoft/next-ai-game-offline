<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC080820"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_ad_loading_card"
        android:gravity="center"
        android:minWidth="216dp"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="22dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_splash_spinner_glow" />

            <ImageView
                android:id="@+id/ivAdLoadingRing"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_splash_loading_ring" />

            <ImageView
                android:id="@+id/ivAdLoadingInnerArc"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_splash_loading_inner_arc" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAdLoadingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="@string/ad_loading_interstitial"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
